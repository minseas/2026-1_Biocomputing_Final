# (77m32s)
hisat2_extract_splice_sites.py ./ref/gencode.v49.annotation.gtf > ./ref/hisat2/splicesites.tsv
hisat2_extract_exons.py ./ref/gencode.v49.annotation.gtf > ./ref/hisat2/exons.tsv
nohup hisat2-build -p 6 --ss ./ref/hisat2/splicesites.tsv --exon ./ref/hisat2/exons.tsv ./ref/GRCh38.primary_assembly.genome.fa ./ref/hisat2/GRCh38p14 > ./log/indxing_hisat2.log 2>&1 &

# star (40m41s)
nohup STAR --runMode genomeGenerate --genomeDir ./ref/star/ --genomeFastaFiles ./ref/GRCh38.primary_assembly.genome.fa --sjdbGTFfile ./ref/gencode.v49.annotation.gtf --runThreadN 6 > ref/star/log_GRCh38p14.log 2>&1 &

# tophat2 (10m45s)
nohup bowtie2-build --threads 6 ./ref/GRCh38.primary_assembly.genome.fa ./ref/tophat2/GRCh38p14 > ref/tophat2/log_GRCh38p14.log 2>&1 &

# logs
mv ./ref/hisat2/log_GRCh38p14.log ./log/indexing_hisat2.log
mv ./ref/tophat2/log_GRCh38p14.log ./log/indexing_tophat2.log
mv ./ref/bwa/log_GRCh38p14.log ./log/indexing_bwa.log
mv ./ref/star/log_GRCh38p14.log ./log/indexing_star.log


